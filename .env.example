# Copy to .env and fill in.

# Discord application (https://discord.com/developers/applications -> OAuth2).
# Add this redirect URL there: <PUBLIC_URL>/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The address people open in the browser, without a trailing slash.
# For local development with `npm run dev` use http://localhost:5173
PUBLIC_URL=http://localhost:3000

# Port the server listens on.
PORT=3000

# SQLite database file. Relative paths are resolved from the repository root.
DATABASE_PATH=data/taskhub.db

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# Local development only: adds a "sign in without Discord" form.
# Ignored when NODE_ENV=production.
DEV_LOGIN=false

# Maximum size of one uploaded image, in megabytes.
MAX_UPLOAD_MB=10
